{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profile records stored in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID matching Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "fullName": { "type": "string", "description": "User full display name" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "country": { "type": "string", "description": "Country of residence" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "emailVerified": { "type": "boolean", "description": "Whether email is verified" },
        "phoneVerified": { "type": "boolean", "description": "Whether phone is verified" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" },
        "homeLocation": { "type": "string", "description": "Home city or location" },
        "bio": { "type": "string", "description": "Short bio or travel intro" },
        "travelPreferences": {
          "type": "array",
          "description": "User travel preferences and interests"
        }
      },
      "required": ["uid", "email"]
    },
    "feed_posts": {
      "title": "Community Feed Posts",
      "description": "Travel stories, photos, and insights posted by users and displayed in community feed and user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique post ID" },
        "authorId": { "type": "string", "description": "Firebase Auth UID of post author" },
        "authorEmail": { "type": "string", "format": "email", "description": "Email of author" },
        "authorName": { "type": "string", "description": "Display name of author" },
        "authorAvatar": { "type": "string", "description": "Avatar URL of author" },
        "location": { "type": "string", "description": "Location or destination tagged in post" },
        "badgeLabel": { "type": "string", "description": "Badge or category label" },
        "imageUrl": { "type": "string", "description": "Image URL of travel post" },
        "likes": { "type": "number", "description": "Total like count" },
        "commentsCount": { "type": "number", "description": "Total comments count" },
        "caption": { "type": "string", "description": "Text caption of post" },
        "hashtags": {
          "type": "array",
          "description": "Hashtag strings associated with post"
        },
        "timeAgo": { "type": "string", "description": "Relative time string" },
        "isLiked": { "type": "boolean", "description": "Client like state" },
        "isBookmarked": { "type": "boolean", "description": "Client bookmark state" },
        "commentsList": {
          "type": "array",
          "description": "List of comment objects"
        },
        "likedBy": {
          "type": "array",
          "description": "List of user UIDs who liked this post"
        },
        "bookmarkedBy": {
          "type": "array",
          "description": "List of user UIDs who bookmarked this post"
        },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" }
      },
      "required": ["id", "authorName", "caption"]
    },
    "quotes": {
      "title": "Travel Quote Requests",
      "description": "Customer flight and visa quote requests",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique quote request ID" },
        "type": { "type": "string", "description": "Type of quote (flight, visa, package, custom)" },
        "userEmail": { "type": "string", "format": "email", "description": "Customer email" },
        "customerName": { "type": "string", "description": "Customer name" },
        "customerPhone": { "type": "string", "description": "Customer phone number" },
        "status": { "type": "string", "description": "Quote status (pending, processing, fulfilled, cancelled)" },
        "createdAt": { "type": "string", "description": "ISO timestamp of quote request" }
      },
      "required": ["userEmail"]
    },
    "buddy_profiles": {
      "title": "Travel Buddy Profiles",
      "description": "User profiles for finding travel companions and matching by destination, style, and travel dates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User ID matching Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Traveler display name" },
        "avatarUrl": { "type": "string", "description": "Profile image URL" },
        "homeLocation": { "type": "string", "description": "Departure city or base" },
        "bio": { "type": "string", "description": "Travel bio and expectations" },
        "destinations": {
          "type": "array",
          "description": "Destinations traveler wants to visit"
        },
        "travelStyles": {
          "type": "array",
          "description": "Travel styles (e.g. adventure, luxury, budget)"
        },
        "languages": {
          "type": "array",
          "description": "Languages spoken by traveler"
        },
        "travelStart": { "type": "string", "description": "Estimated departure date" },
        "travelEnd": { "type": "string", "description": "Estimated return date" },
        "groupSize": { "type": "number", "description": "Preferred travel group size" },
        "contactPreference": { "type": "string", "description": "Preferred contact method" },
        "visibility": { "type": "string", "description": "Profile visibility (public or connections_only)" },
        "isActive": { "type": "boolean", "description": "Whether buddy search profile is active" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["id", "displayName"]
    },
    "buddy_requests": {
      "title": "Travel Buddy Connection Requests",
      "description": "Connection requests between travelers with private messages and acceptance workflow",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique connection request ID" },
        "senderId": { "type": "string", "description": "UID of sender" },
        "receiverId": { "type": "string", "description": "UID of receiver" },
        "message": { "type": "string", "description": "Private introductory message" },
        "status": { "type": "string", "description": "Status (pending, accepted, declined)" },
        "senderProfile": { "type": "object", "description": "Snapshot of sender public profile" },
        "receiverProfile": { "type": "object", "description": "Snapshot of receiver public profile" },
        "createdAt": { "type": "string", "description": "ISO timestamp of request" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of status update" }
      },
      "required": ["id", "senderId", "receiverId", "status"]
    },
    "requests": {
      "title": "Unified Travel Requests & Quotes",
      "description": "Central customer travel requests from flights, visas, packages, hotels, AI planner, contact forms, and custom itineraries",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique database ID" },
        "request_id": { "type": "string", "description": "Sequential request reference ID (e.g., AZQ-20260831-00001)" },
        "user_id": { "type": "string", "description": "Optional Firebase Auth UID" },
        "request_type": { "type": "string", "description": "Type of service request" },
        "customer_name": { "type": "string", "description": "Customer display name" },
        "customer_email": { "type": "string", "format": "email", "description": "Customer email" },
        "customer_phone": { "type": "string", "description": "Customer phone number" },
        "subject": { "type": "string", "description": "Subject or request title" },
        "destination": { "type": "string", "description": "Destination city/country" },
        "origin": { "type": "string", "description": "Origin city/airport" },
        "travel_date": { "type": "string", "description": "Intended travel departure date" },
        "return_date": { "type": "string", "description": "Intended return date" },
        "passengers": { "type": "number", "description": "Passenger or traveler count" },
        "message": { "type": "string", "description": "Customer notes and requirements" },
        "status": { "type": "string", "description": "Status: NEW, CONTACTED, PROCESSING, WAITING_FOR_CUSTOMER, COMPLETED, CANCELLED" },
        "priority": { "type": "string", "description": "Priority: LOW, NORMAL, HIGH, URGENT" },
        "assigned_to": { "type": "string", "description": "Staff member assigned" },
        "email_notification_status": { "type": "string", "description": "Email delivery status: PENDING, SENT, FAILED" },
        "created_at": { "type": "string", "description": "ISO timestamp of creation" },
        "updated_at": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["id", "request_id", "customer_name", "customer_email", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles collection"
    },
    "/feed_posts/{postId}": {
      "schema": "feed_posts",
      "description": "Community travel stories and posts"
    },
    "/quotes/{quoteId}": {
      "schema": "quotes",
      "description": "Flight and visa quotation inquiries"
    },
    "/requests/{requestId}": {
      "schema": "requests",
      "description": "Central requests and quotations repository"
    },
    "/buddy_profiles/{userId}": {
      "schema": "buddy_profiles",
      "description": "Travel buddy profiles searchable by destination and travel dates"
    },
    "/buddy_requests/{requestId}": {
      "schema": "buddy_requests",
      "description": "Private connection requests between travel companions"
    }
  }
}
