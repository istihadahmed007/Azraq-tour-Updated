rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ----------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'istihadahmed1163@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ----------------------------------------------------
    // 1. Users Collection: STRICT PII ISOLATION
    // Only the authenticated account owner or admin can read/write.
    // ----------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // 2. Travel Quotes Collection: OWNER & ADMIN RESTRICTED
    // Anyone can submit a quote request.
    // ONLY the quote's requester (by email/UID) or an Admin can read or manage it.
    // ----------------------------------------------------
    match /quotes/{quoteId} {
      allow create: if true;
      allow read: if isAuthenticated() && (
        resource.data.userEmail == request.auth.token.email ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userEmail == request.auth.token.email ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ----------------------------------------------------
    // 3. Community Feed Posts: Public Read, Author/Admin Write
    // ----------------------------------------------------
    match /feed_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.authorEmail == request.auth.token.email ||
        isAdmin() ||
        // Allow liking / bookmarking counters by authenticated users
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'likedBy', 'isLiked', 'commentsList', 'commentsCount', 'bookmarkedBy'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.authorEmail == request.auth.token.email ||
        isAdmin()
      );
    }

    // ----------------------------------------------------
    // 4. Travel Buddy Public Profiles: Public Read, Owner Write
    // ----------------------------------------------------
    match /buddy_profiles/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    // ----------------------------------------------------
    // 5. Travel Buddy Private Requests: Sender & Receiver ONLY
    // ----------------------------------------------------
    match /buddy_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
    }

    // ----------------------------------------------------
    // 6. Test & Connection Checks
    // ----------------------------------------------------
    match /test/{docId} {
      allow read: if true;
    }

    // ----------------------------------------------------
    // 7. Global Catch-All: DENY ALL BY DEFAULT
    // ----------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
