CLOUDINARY_CLOUD_NAME=vd722ywp
CLOUDINARY_API_KEY=897229884945796
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=vd722ywp
VITE_CLOUDINARY_UPLOAD_PRESET=travel_buddies_unsigned

